<?xml version="1.0" encoding="UTF-8"?>
<!--
  Describes the system itself: which FMUs are included, how they are
  connected, and the step size. run_simulation.py, cosim CLI and OSP-GUI
  all read this file.

      heading_deg ──► environment ──► wind_speed, relative_wind_direction_deg ──► windloads ──► X, Y, N, K
                                                                                                │
                                                                    tau_wind_x, tau_wind_y, tau_wind_n
                                                                                                ▼
                         north_meas, east_meas, psi_meas, tau_thr_* ──► kalman_filter ──► *_hat
                                                                                                    │
                                    north_hat, east_hat, psi_hat, u_hat, v_hat, r_hat ◄─────────────┘
                                                        ▼
                                                  dp_controller ──► tau_X, tau_Y, tau_N ──► allocation

      tau_X, tau_Y, tau_N ──► allocation ──► dynamics ──► X, Y, N (not connected yet)
                                  thrust and azimuth command per slot (thruster1..8)

      environment ──► H_s, T_p, wave_direction_deg ──► waves ──► wave<k>_amplitude, _omega, _phase,
                                                                  _direction_deg, k = 1..100 (not connected yet)

  The constants are NOT here, but in config.toml. This file only sets:
    - config_path:  where each FMU finds the config file
    - heading_deg:  constant for now, later connected from the hull FMU
    - tau_X, tau_Y, tau_N on allocation: connected from dp_controller, which
      holds the vessel at the set-point in [controller] in config.toml.
    - kalman_filter measurements and thruster forces (tau_thr_*): not
      connected yet, so they stay 0 (vessel held at the origin, no thrust).
    - dynamics X, Y, N: not connected yet. Another stakeholder's FMU will
      take them.
    - waves wave<k>_*: not connected yet. The hull FMU will take them
      (4 per wave component, see docs/waves_fmu.md).
  All 8 thruster slots are connected, so a layout with fewer thrusters needs
  no change here: the empty slots carry 0. The thrusterK_available inputs
  start as true on both thruster FMUs.
-->
<OspSystemStructure xmlns="http://opensimulationplatform.com/MSMI/OSPSystemStructure" version="0.1">
    <StartTime>0.0</StartTime>
    <BaseStepSize>0.1</BaseStepSize>
    <Algorithm>fixedStep</Algorithm>

    <Simulators>
        <!-- Relative paths are read from the folder the simulation is
             started from. Use a full path, such as C:\...\config.toml,
             if the tool runs from another folder (for example OSP-GUI). -->
        <Simulator name="environment" source="fmus/Environment.fmu">
            <InitialValues>
                <InitialValue variable="config_path">
                    <String value="config.toml"/>
                </InitialValue>
            </InitialValues>
        </Simulator>

        <Simulator name="windloads" source="fmus/WindLoads_Blendermann.fmu">
            <InitialValues>
                <InitialValue variable="config_path">
                    <String value="config.toml"/>
                </InitialValue>
            </InitialValues>
        </Simulator>

        <!-- Minimal example of the set-up: output = input * test (test from config.toml). -->
        <Simulator name="test" source="fmus/Test.fmu">
            <InitialValues>
                <InitialValue variable="config_path">
                    <String value="config.toml"/>
                </InitialValue>
                <InitialValue variable="input">
                    <Real value="3.0"/>
                </InitialValue>
            </InitialValues>
        </Simulator>

        <Simulator name="kalman_filter" source="fmus/ExtendedKalmanFilter.fmu">
            <InitialValues>
                <InitialValue variable="config_path">
                    <String value="config.toml"/>
                </InitialValue>
            </InitialValues>
        </Simulator>

        <!-- DP controller: see docs/dp_controller.md. -->
        <Simulator name="dp_controller" source="fmus/DPController.fmu">
            <InitialValues>
                <InitialValue variable="config_path">
                    <String value="config.toml"/>
                </InitialValue>
            </InitialValues>
        </Simulator>

        <!-- Thrusters: see docs/thruster_fmus.md. -->
        <Simulator name="allocation" source="fmus/ThrustAllocation.fmu">
            <InitialValues>
                <InitialValue variable="config_path">
                    <String value="config.toml"/>
                </InitialValue>
            </InitialValues>
        </Simulator>

        <Simulator name="dynamics" source="fmus/ThrusterDynamics.fmu">
            <InitialValues>
                <InitialValue variable="config_path">
                    <String value="config.toml"/>
                </InitialValue>
            </InitialValues>
        </Simulator>

        <!-- Waves: see docs/waves_fmu.md. -->
        <Simulator name="waves" source="fmus/Waves.fmu">
            <InitialValues>
                <InitialValue variable="config_path">
                    <String value="config.toml"/>
                </InitialValue>
            </InitialValues>
        </Simulator>
    </Simulators>

    <!-- Each VariableConnection goes from an output (first) to an input (second). -->
    <Connections>
        <VariableConnection>
            <Variable simulator="environment" name="wind_speed"/>
            <Variable simulator="windloads" name="wind_speed"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="environment" name="relative_wind_direction_deg"/>
            <Variable simulator="windloads" name="relative_wind_direction_deg"/>
        </VariableConnection>

        <!-- windloads -> kalman_filter (wind feed-forward, body frame) -->
        <VariableConnection>
            <Variable simulator="windloads" name="X"/>
            <Variable simulator="kalman_filter" name="tau_wind_x"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="windloads" name="Y"/>
            <Variable simulator="kalman_filter" name="tau_wind_y"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="windloads" name="N"/>
            <Variable simulator="kalman_filter" name="tau_wind_n"/>
        </VariableConnection>

        <!-- kalman_filter -> dp_controller (estimates) -->
        <VariableConnection>
            <Variable simulator="kalman_filter" name="north_hat"/>
            <Variable simulator="dp_controller" name="north_hat"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="kalman_filter" name="east_hat"/>
            <Variable simulator="dp_controller" name="east_hat"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="kalman_filter" name="psi_hat"/>
            <Variable simulator="dp_controller" name="psi_hat"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="kalman_filter" name="u_hat"/>
            <Variable simulator="dp_controller" name="u_hat"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="kalman_filter" name="v_hat"/>
            <Variable simulator="dp_controller" name="v_hat"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="kalman_filter" name="r_hat"/>
            <Variable simulator="dp_controller" name="r_hat"/>
        </VariableConnection>

        <!-- dp_controller -> allocation (commanded force, body frame) -->
        <VariableConnection>
            <Variable simulator="dp_controller" name="tau_X"/>
            <Variable simulator="allocation" name="tau_X"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="dp_controller" name="tau_Y"/>
            <Variable simulator="allocation" name="tau_Y"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="dp_controller" name="tau_N"/>
            <Variable simulator="allocation" name="tau_N"/>
        </VariableConnection>

        <!-- allocation -> dynamics: thrust and azimuth command for each of the 8 slots -->
        <VariableConnection>
            <Variable simulator="allocation" name="thruster1_thrust_command"/>
            <Variable simulator="dynamics" name="thruster1_thrust_command"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster1_azimuth_command_deg"/>
            <Variable simulator="dynamics" name="thruster1_azimuth_command_deg"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster2_thrust_command"/>
            <Variable simulator="dynamics" name="thruster2_thrust_command"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster2_azimuth_command_deg"/>
            <Variable simulator="dynamics" name="thruster2_azimuth_command_deg"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster3_thrust_command"/>
            <Variable simulator="dynamics" name="thruster3_thrust_command"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster3_azimuth_command_deg"/>
            <Variable simulator="dynamics" name="thruster3_azimuth_command_deg"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster4_thrust_command"/>
            <Variable simulator="dynamics" name="thruster4_thrust_command"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster4_azimuth_command_deg"/>
            <Variable simulator="dynamics" name="thruster4_azimuth_command_deg"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster5_thrust_command"/>
            <Variable simulator="dynamics" name="thruster5_thrust_command"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster5_azimuth_command_deg"/>
            <Variable simulator="dynamics" name="thruster5_azimuth_command_deg"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster6_thrust_command"/>
            <Variable simulator="dynamics" name="thruster6_thrust_command"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster6_azimuth_command_deg"/>
            <Variable simulator="dynamics" name="thruster6_azimuth_command_deg"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster7_thrust_command"/>
            <Variable simulator="dynamics" name="thruster7_thrust_command"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster7_azimuth_command_deg"/>
            <Variable simulator="dynamics" name="thruster7_azimuth_command_deg"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster8_thrust_command"/>
            <Variable simulator="dynamics" name="thruster8_thrust_command"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="allocation" name="thruster8_azimuth_command_deg"/>
            <Variable simulator="dynamics" name="thruster8_azimuth_command_deg"/>
        </VariableConnection>

        <!-- environment -> waves (sea state) -->
        <VariableConnection>
            <Variable simulator="environment" name="H_s"/>
            <Variable simulator="waves" name="H_s"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="environment" name="T_p"/>
            <Variable simulator="waves" name="T_p"/>
        </VariableConnection>
        <VariableConnection>
            <Variable simulator="environment" name="wave_direction_deg"/>
            <Variable simulator="waves" name="wave_direction_deg"/>
        </VariableConnection>
    </Connections>
</OspSystemStructure>
